# Copy to config/lab.env and adjust. config/lab.env is git-ignored.
# Stable IP on a dummy interface (independent of Wi-Fi/VPN)
LAB_IP=10.99.0.1
# sslip.io resolves <anything>.<IP>.sslip.io to <IP>
LAB_DOMAIN=${LAB_IP}.sslip.io
RANCHER_HOST=rancher.${LAB_DOMAIN}
S3_HOST=s3.${LAB_DOMAIN}
TODO_HOST=todo.${LAB_DOMAIN}
# Host port mapped to port 80 of the work cluster's load balancer
WORK_HTTP_PORT=8081
